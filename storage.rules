rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default-deny all paths by default to avoid accidental exposure
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Identity Platform Custom Claims for Clinic Staff and Admins
    function isClinicStaff(clinicId) {
      return isSignedIn() && (
        (request.auth.token.clinicId == clinicId && (request.auth.token.role == 'clinic_staff' || request.auth.token.role == 'clinic_admin'))
        || request.auth.token.admin == true
      );
    }

    // --- 1. Private Patient Photo Storage ---
    // Path: /users/{userId}/photos/{photoId}
    match /users/{userId}/photos/{photoId} {
      allow read, get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|heic)');
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/scans/{fileName} {
      allow read, get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|heic)');
      allow delete: if isOwner(userId);
    }

    // --- 2. Clinic Mode Multi-Tenant Case Photo Storage ---
    // Path: /clinics/{clinicId}/cases/{caseId}/photos/{photoId}
    match /clinics/{clinicId}/cases/{caseId}/photos/{photoId} {
      // Only authenticated clinic staff from this specific clinic can read photos
      allow read, get: if clinicId != 'demo-practice' && isClinicStaff(clinicId);

      // Write-only upload permitted for patients submitting an intake form to this clinic or clinic staff
      allow create: if clinicId != 'demo-practice'
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|heic)');

      allow update: if clinicId != 'demo-practice' && isClinicStaff(clinicId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|heic)');

      // Clinic admin only can delete photos
      allow delete: if clinicId != 'demo-practice'
        && isSignedIn()
        && request.auth.token.clinicId == clinicId
        && request.auth.token.role == 'clinic_admin';
    }
  }
}
