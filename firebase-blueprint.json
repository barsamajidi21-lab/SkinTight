{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "ageRange": { "type": "string" },
        "fitzpatrickType": { "type": "integer" },
        "profileColor": { "type": "string" },
        "skinScore": { "type": "integer" },
        "streakDays": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "scansCompleted": { "type": "integer" },
        "ethnicity": { "type": "string" },
        "lastScanDate": { "type": "string", "format": "date-time" },
        "highUvDays": { "type": "integer" },
        "nextScanDate": { "type": "string" },
        "cycleProgress": { "type": "integer" },
        "streakData": {
          "type": "object",
          "properties": {
            "currentStreak": { "type": "integer" },
            "longestStreak": { "type": "integer" },
            "lastScanMonth": { "type": "string" }
          }
        },
        "bodyDots": { "type": "array" }
      },
      "required": ["email", "username"]
    },
    "Scan": {
      "title": "Scan",
      "description": "A single skin scan entry",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "result": { "type": "object" },
        "note": { "type": "string" },
        "photos": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ScoreHistory": {
      "title": "Score History",
      "description": "Historical skin scores",
      "type": "object",
      "properties": {
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "format": "date-time" },
              "score": { "type": "integer" }
            }
          }
        }
      }
    },
    "DoctorInfo": {
      "title": "Doctor Info",
      "description": "Dermatologist contact information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "clinic": { "type": "string" },
        "address": { "type": "string" }
      }
    },
    "UsernameMap": {
      "title": "Username Map",
      "description": "Maps username to UID to enforce uniqueness",
      "type": "object",
      "properties": {
        "uid": { "type": "string" }
      }
    },
    "Cycle": {
      "title": "Cycle",
      "description": "Weekly or monthly scan cycle progress",
      "type": "object",
      "properties": {
        "zone1": { "type": "boolean" },
        "zone2": { "type": "boolean" },
        "zone3": { "type": "boolean" },
        "zone4": { "type": "boolean" }
      }
    },
    "Clinic": {
      "title": "Clinic",
      "description": "Clinic multi-tenant organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "zip": { "type": "string" },
        "website": { "type": "string" },
        "activeRulesVersion": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "ClinicCase": {
      "title": "Clinic Case",
      "description": "Incoming pre-visit patient case for clinic triage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clinicId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientEmail": { "type": "string" },
        "patientPhone": { "type": "string" },
        "patientDob": { "type": "string" },
        "submissionDate": { "type": "string" },
        "triageColor": { "type": "string" },
        "whyLine": { "type": "string" },
        "triggeredRules": { "type": "array" },
        "rulesVersion": { "type": "string" },
        "answers": { "type": "object" },
        "patientReportedSummary": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "clinicId", "patientName", "triageColor"]
    },
    "ClinicRule": {
      "title": "Clinic Rule Set",
      "description": "Configurable triage rules approved by clinic physician",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "approvalStatus": { "type": "string" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string" },
        "rules": { "type": "array" }
      }
    },
    "ClinicAuditLog": {
      "title": "Clinic Audit Log",
      "description": "Immutable audit record for HIPAA compliance and security logging",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clinicId": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string" },
        "resourceType": { "type": "string" },
        "resourceId": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "required": ["id", "clinicId", "timestamp", "userId", "action"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/scans/{scanId}": {
      "schema": "Scan",
      "description": "User skin scans"
    },
    "/users/{userId}/timeline/scores": {
      "schema": "ScoreHistory",
      "description": "User score history"
    },
    "/users/{userId}/doctorInfo/current": {
      "schema": "DoctorInfo",
      "description": "User's doctor contact"
    },
    "/users/{userId}/cycles/{cycleId}": {
      "schema": "Cycle",
      "description": "User scan cycle progress"
    },
    "/usernames/{username}": {
      "schema": "UsernameMap",
      "description": "Username registry"
    },
    "/clinics/{clinicId}": {
      "schema": "Clinic",
      "description": "Clinic profile and metadata"
    },
    "/clinics/{clinicId}/cases/{caseId}": {
      "schema": "ClinicCase",
      "description": "Clinic pre-visit triage cases"
    },
    "/clinics/{clinicId}/rules/{ruleDoc}": {
      "schema": "ClinicRule",
      "description": "Active clinic triage rules configuration"
    },
    "/clinics/{clinicId}/rulesHistory/{versionId}": {
      "schema": "ClinicRule",
      "description": "Immutable version history of physician rule approvals"
    },
    "/clinics/{clinicId}/auditLogs/{logId}": {
      "schema": "ClinicAuditLog",
      "description": "Immutable audit logs for compliance"
    }
  }
}
