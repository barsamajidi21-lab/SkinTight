rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check
    match /_health_check_/heartbeat {
      allow get: if true;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 256 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Identity Platform Custom Claims for Clinic Multi-Tenancy
    function isClinicStaff(clinicId) {
      return isSignedIn() && (
        (request.auth.token.clinicId == clinicId && (request.auth.token.role == 'clinic_staff' || request.auth.token.role == 'clinic_admin'))
        || request.auth.token.admin == true
      );
    }

    function isClinicAdmin(clinicId) {
      return isSignedIn() && (
        (request.auth.token.clinicId == clinicId && request.auth.token.role == 'clinic_admin')
        || request.auth.token.admin == true
      );
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['username', 'email', 'skinScore', 'scansCompleted'])
        && data.username is string && data.username.size() <= 64
        && data.email is string && data.email.size() <= 128
        && data.get('skinScore', 100) is int
        && data.get('scansCompleted', 0) is int;
    }

    function isValidScan(data) {
      return data.keys().hasAll(['date', 'result'])
        && data.result is map;
    }

    function isValidUsernameMap(data) {
      return data.keys().hasAll(['uid'])
        && data.uid is string && data.uid.size() <= 128;
    }

    function isValidDemoRequest(data) {
      return data.keys().hasAll(['name', 'practiceName', 'role', 'workEmail', 'phone', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.practiceName is string && data.practiceName.size() > 0 && data.practiceName.size() <= 160
        && data.role is string && data.role.size() > 0 && data.role.size() <= 80
        && data.workEmail is string && data.workEmail.size() > 3 && data.workEmail.size() <= 160
        && data.phone is string && data.phone.size() > 3 && data.phone.size() <= 40
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // --- Collections ---

    // 1. Patient User Profiles & Longitudinal History
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId)
        && (!('email' in incoming()) || incoming().email == existing().email)
        && (!('username' in incoming()) || incoming().username == existing().username);

      match /scans/{scanId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(scanId);
        allow create: if isOwner(userId) && isValidScan(incoming());
        allow update: if isOwner(userId) && isValidScan(incoming());
        allow delete: if isOwner(userId) && isValidId(scanId);
      }

      match /cycles/{cycleId} {
        allow get: if isOwner(userId) && isValidId(cycleId);
        allow write: if isOwner(userId);
      }

      match /timeline/scores {
        allow get: if isOwner(userId);
        allow write: if isOwner(userId) && (incoming().get('history', []) is list);
      }

      match /doctorInfo/current {
        allow get: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // 2. Multi-Tenant Clinic Mode Collections (/clinics/{clinicId})
    match /clinics/{clinicId} {
      // Clinic metadata profile (demo-practice is never persisted here)
      allow get: if clinicId != 'demo-practice';
      allow write: if clinicId != 'demo-practice' && isClinicAdmin(clinicId);

      // Incoming Patient Triage Cases
      match /cases/{caseId} {
        // Only staff of THIS clinic can view or list cases
        allow list, get: if clinicId != 'demo-practice' && isClinicStaff(clinicId);

        // Creation is allowed via clinic intake link (write-only dropbox for incoming submissions)
        allow create: if clinicId != 'demo-practice' && isValidId(caseId);

        // Updates (status changes, triage color overrides) permitted for clinic staff of THIS clinic
        allow update: if clinicId != 'demo-practice' && isClinicStaff(clinicId);

        // Deletions restricted strictly to clinic administrator
        allow delete: if clinicId != 'demo-practice' && isClinicAdmin(clinicId);
      }

      // Clinic Configurable Rules & Governance
      match /rules/{ruleDoc} {
        allow get, list: if clinicId != 'demo-practice';
        allow write: if clinicId != 'demo-practice' && isClinicAdmin(clinicId);
      }

      match /rulesHistory/{versionId} {
        allow get, list: if clinicId != 'demo-practice' && isClinicStaff(clinicId);
        allow create: if clinicId != 'demo-practice' && isClinicAdmin(clinicId);
        allow update, delete: if false; // Immutable version ledger
      }

      // Immutable Access & Audit Log Collection
      match /auditLogs/{logId} {
        // Only clinic staff of THIS clinic can read audit logs
        allow list, get: if clinicId != 'demo-practice' && isClinicStaff(clinicId);

        // Staff & intake portal can append audit entries
        allow create: if clinicId != 'demo-practice' && isValidId(logId);

        // Audit logs are strictly immutable. Staff and admins cannot edit or delete.
        allow update, delete: if false;
      }
    }

    // 3. Username Uniqueness Registry
    match /usernames/{username} {
      allow get: if true;
      allow create: if isSignedIn() && isValidUsernameMap(incoming())
        && incoming().uid == request.auth.uid;
    }

    // 4. B2B Clinic Demo Requests (Write-only public submission, private storage)
    match /demoRequests/{requestId} {
      allow read, update, delete: if false;
      allow create: if isValidId(requestId) && isValidDemoRequest(incoming());
    }
  }
}
