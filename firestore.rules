rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check
    match /_health_check_/heartbeat {
      allow get: if true;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 256 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Identity Platform Custom Claims for Clinic Multi-Tenancy
    function isClinicStaff(clinicId) {
      return isSignedIn() && (
        (request.auth.token.clinicId == clinicId && (request.auth.token.role == 'clinic_staff' || request.auth.token.role == 'clinic_admin'))
        || request.auth.token.admin == true
      );
    }

    function isClinicAdmin(clinicId) {
      return isSignedIn() && (
        (request.auth.token.clinicId == clinicId && request.auth.token.role == 'clinic_admin')
        || request.auth.token.admin == true
      );
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['username', 'email', 'skinScore', 'scansCompleted'])
        && data.username is string && data.username.size() <= 64
        && data.email is string && data.email.size() <= 128
        && data.get('skinScore', 100) is int
        && data.get('scansCompleted', 0) is int;
    }

    function isValidScan(data) {
      return data.keys().hasAll(['date', 'result'])
        && data.result is map;
    }

    function isValidUsernameMap(data) {
      return data.keys().hasAll(['uid'])
        && data.uid is string && data.uid.size() <= 128;
    }

    // --- Collections ---

    // 1. Patient User Profiles & Longitudinal History
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) 
        && (!('email' in incoming()) || incoming().email == existing().email)
        && (!('username' in incoming()) || incoming().username == existing().username);
      
      match /scans/{scanId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(scanId);
        allow create: if isOwner(userId) && isValidScan(incoming());
        allow update: if isOwner(userId) && isValidScan(incoming());
        allow delete: if isOwner(userId) && isValidId(scanId);
      }

      match /cycles/{cycleId} {
        allow get: if isOwner(userId) && isValidId(cycleId);
        allow write: if isOwner(userId);
      }

      match /timeline/scores {
        allow get: if isOwner(userId);
        allow write: if isOwner(userId) && (incoming().get('history', []) is list);
      }

      match /doctorInfo/current {
        allow get: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // 2. Multi-Tenant Clinic Mode Collections (/clinics/{clinicId})
    match /clinics/{clinicId} {
      // Clinic metadata profile
      allow get: if true;
      allow write: if isClinicAdmin(clinicId);

      // Incoming Patient Triage Cases
      match /cases/{caseId} {
        // Staff of THIS clinic can view cases. Cross-clinic access is mathematically blocked.
        allow list, get: if isClinicStaff(clinicId);
        
        // Creation is allowed via authenticated or patient intake submission
        allow create: if isValidId(caseId);

        // Updates (status changes, triage color overrides) permitted for clinic staff
        allow update: if isClinicStaff(clinicId);

        // Deletions restricted strictly to clinic administrator
        allow delete: if isClinicAdmin(clinicId);
      }

      // Clinic Configurable Rules & Governance
      match /rules/{ruleDoc} {
        allow get, list: if true;
        allow write: if isClinicAdmin(clinicId);
      }

      match /rulesHistory/{versionId} {
        allow get, list: if isClinicStaff(clinicId);
        allow create: if isClinicAdmin(clinicId);
        allow update, delete: if false; // Immutable version ledger
      }

      // Immutable HIPAA Access & Audit Log Collection
      match /auditLogs/{logId} {
        // Only clinic staff can read audit logs
        allow list, get: if isClinicStaff(clinicId);

        // Staff & system can append audit entries
        allow create: if isValidId(logId);

        // CRITICAL: Audit logs are strictly immutable. Staff and admins cannot edit or delete.
        allow update, delete: if false;
      }
    }

    // 3. Username Uniqueness Registry
    match /usernames/{username} {
      allow get: if true;
      allow create: if isSignedIn() && isValidUsernameMap(incoming()) 
        && incoming().uid == request.auth.uid;
    }
  }
}
